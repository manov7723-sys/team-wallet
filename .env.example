NEXT_PUBLIC_TEAM_WALLET_PROGRAM_ID=2CeVF4gvaMV6GGF7pSbZgyrP7YtWwALRVAi8CcPP3t72

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/teamwallet

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long

# S3 (optional — set UPLOAD_MODE=local to skip)
