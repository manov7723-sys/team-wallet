name: CI Pipeline

on:
  push:
    branches:
      - release
  pull_request:
    branches:
      - release

jobs:
  quality-checks:
    name: Code Quality Checks
    runs-on: ubuntu-latest
    steps:
      - name: 🔍 Debug - Show GitHub Context
        run: |
          echo "=============================================="
          echo "🔍 GITHUB CONTEXT INFORMATION"
          echo "=============================================="
          echo "Event name: ${{ github.event_name }}"
          echo "Repository: ${{ github.repository }}"
          echo "Ref: ${{ github.ref }}"
          echo "Ref name: ${{ github.ref_name }}"
          echo "Base ref: ${{ github.base_ref }}"
          echo "Head ref: ${{ github.head_ref }}"
          echo "SHA: ${{ github.sha }}"
          echo "Actor: ${{ github.actor }}"
          echo "=============================================="

      - name: 📥 Checkout code from release branch
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event_name == 'pull_request' && github.head_ref || 'release' }}
          fetch-depth: 0

      - name: 🔍 Verify branch checkout
        run: |
          echo "=============================================="
          echo "✅ BRANCH VERIFICATION"
          echo "=============================================="
          echo "Current branch: $(git branch --show-current)"
          echo "Current commit SHA: $(git rev-parse HEAD)"
          echo "Commit message: $(git log -1 --pretty=%B)"
          echo "Commit author: $(git log -1 --pretty=%an)"
          echo "Commit date: $(git log -1 --pretty=%ad)"
          echo ""
          echo "📂 Files in current directory:"
          ls -la
          echo ""
          echo "✅ Confirmed: Working on branch '$(git branch --show-current)'"
          echo "=============================================="

      - name: ⚙️ Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24.3.0"
          #cache: 'npm'

      - name: 🔍 Check Node and npm versions
        run: |
          echo "=============================================="
          echo "Node version: $(node --version)"
          echo "npm version: $(npm --version)"
          echo "=============================================="

      - name: 📦 Install dependencies
        run: |
          echo "📦 Installing dependencies..."
          npm install
          echo "✅ Dependencies installed"

      - name: Format the code
        run: |
          echo "Formatting code"
          npm run format
          echo "Format completed"

      - name: 🔍 Verify package.json scripts
        run: |
          echo "=============================================="
          echo "📋 Available npm scripts:"
          npm run
          echo "=============================================="

      - name: 📘 Run TypeScript type check
        run: |
          echo "📘 Running TypeScript type check..."
          npm run type-check
          echo "✅ Type check passed"

      - name: 🔍 Run linting
        run: |
          echo "🔍 Running ESLint..."
          npm run lint
          echo "✅ Linting passed"

      - name: 🎨 Run formatting check
        run: |
          echo "🎨 Running Prettier format check..."
          npm run format:check
          echo "✅ Format check passed"

      - name: 🏗️ Build project
        run: |
          echo "🏗️ Building project..."
          npm run build
          echo "✅ Build completed"
        env:
          NODE_ENV: production
          NEXT_PUBLIC_API: https://api.devnet.solana.com
          #NEXT_PUBLIC_SOLANA_RPC_URL: https://devnet.helius.rpcpool.com
          NEXT_PUBLIC_SOLANA_RPC_URL: https://devnet.helius-rpc.com/?api-key=aa0da0ba-0e10-4980-a604-c0534d2106bd
          #NEXT_PUBLIC_API: https://api.devnet.solana.com
          #NEXT_PUBLIC_TEAM_WALLET_PROGRAM_ID: 8WiqJ2iyVCSyr2BUw3durbTkN8i2ueTU6v1i6oBne4EE
          NEXT_PUBLIC_TEAM_WALLET_PROGRAM_ID: 37prM39joFz9ehcaHsChoFaDX48MdCjhf6jDDpD2f1Vo
          NEXT_PUBLIC_HELIUS_API_KEY: 83a546b2-2526-41d6-a8b4-ec4deb8c94fc
          NEXTAUTH_SECRET: QgXRQ+JjK+Yc+ffl5rkgUcjeTfIWJr6ARwD9ftFopGM=
          NEXTAUTH_URL: http://localhost:3000
          NEXT_PUBLIC_WS_URL: ws://localhost:3001
          JWT_SECRET: jwt_access_secret_123456789_secure

      - name: 📊 Build verification
        run: |
          echo "=============================================="
          echo "📊 BUILD VERIFICATION"
          echo "=============================================="
          if [ -d ".next" ]; then
            echo "✅ .next directory created"
            echo "Build output size:"
            du -sh .next
          else
            echo "❌ .next directory not found"
            exit 1
          fi
          echo "=============================================="

      - name: ✅ All quality checks passed
        if: success()
        run: |
          echo "=============================================="
          echo "✅ SUCCESS! ALL QUALITY CHECKS PASSED"
          echo "=============================================="
          echo "Branch: $(git branch --show-current)"
          echo "Commit: ${{ github.sha }}"
          echo "Triggered by: ${{ github.actor }}"
          echo ""
          echo "✅ Format check: PASSED"
          echo "✅ Lint check: PASSED"
          echo "✅ Type check: PASSED"
          echo "✅ Build: PASSED"
          echo "=============================================="

      - name: ❌ Quality checks failed
        if: failure()
        run: |
          echo "=============================================="
          echo "❌ QUALITY CHECKS FAILED"
          echo "=============================================="
          echo "Please review the errors above and fix them."
          echo "Branch: $(git branch --show-current)"
          echo "Commit: ${{ github.sha }}"
          echo "=============================================="
  deploy:
    name: Deploy to Vercel
    needs: quality-checks
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/release'
    steps:
      - name: 🚀 Trigger Vercel Deployment
        run: |
          echo "🚀 Deploying to Vercel..."
          curl -X POST "https://api.vercel.com/v1/integrations/deploy/$VERCEL_HOOK_ID" -H "Content-Type: application/json"
          echo "✅ Deployment triggered"
        env:
          VERCEL_HOOK_ID: prj_0jv5x4oUtkA1pcOxA8KYOapQFJg0/SYmnkduVU5
