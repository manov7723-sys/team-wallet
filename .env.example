AWS_S3_BUCKET=teamwallet-uploads
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local uploads
LOCAL_UPLOAD_DIR=public/uploads
# IPFS uploads (server-side only)
NEXT_PUBLIC_PINATA_JWT=

# Trade (server-side only)
JUPITER_API_KEY=
BIRDEYE_API_KEY=
